// Cloudflare Workers static assets. `npm run build` outputs to dist/ with one HTML file per page
// (scripts/seo.mjs), so /pricing is served from pricing.html and unknown URLs get 404.html with a
// real 404 status. (Cloudflare Pages needs no config: build command `npm run build`, output `dist`.)
{
  "name": "personal-site",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
